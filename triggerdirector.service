[Unit]
Description=Trigger Director
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -u /home/pi/triggerdirector/director.py
WorkingDirectory=/home/pi/triggerdirector
Restart=always
RestartSec=5
User=pi
Group=pi

[Install]
WantedBy=multi-user.target
